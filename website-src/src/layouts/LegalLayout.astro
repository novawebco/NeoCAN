---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RegulatoryNotice from '../components/RegulatoryNotice.astro';
import { business } from '../data/business';
interface Props { title: string; description: string; toc: { id: string; label: string }[]; path: string; effective?: string; draft?: boolean }
const { title, description, toc, path, effective, draft = true } = Astro.props;
---
<Base title={`${title} | NeoCAN`} description={description}>
  <section class="bg-soft border-b border-line"><div class="container-x py-10"><Breadcrumbs crumbs={[{ label: title, href: path }]} /><h1 class="t-page mt-6">{title}</h1><p class="mt-3 max-w-2xl">{description}</p></div></section>
  <section class="section">
    <div class="container-x grid lg:grid-cols-[16rem_1fr] gap-12">
      <nav aria-label="On this page" class="lg:sticky lg:top-28 self-start text-sm">
        <p class="font-display font-bold text-ink mb-3">On this page</p>
        <ul class="space-y-2 border-l-2 border-line">{toc.map((t) => <li><a class="block pl-4 -ml-[2px] border-l-2 border-transparent hover:border-brand hover:text-ink" href={`#${t.id}`}>{t.label}</a></li>)}</ul>
      </nav>
      <div class="min-w-0">
        {effective && <p class="mb-4 font-display font-bold text-ink">Effective from {effective}</p>}
        {draft && <div class="mb-8"><RegulatoryNotice title="Draft for legal review" text={`This text is a working draft prepared for local development. It must be reviewed by a qualified legal professional and approved by NeoCAN before publication.${effective ? '' : ' The effective date has not been set.'}`} /></div>}
        <div class="prose-neo"><slot /></div>
        <p class="prose-neo mt-10 text-sm">Questions? Contact {business.legalName} at <a href={`mailto:${business.email}`}>{business.email}</a>, {business.address.full}.</p>
      </div>
    </div>
  </section>
</Base>
