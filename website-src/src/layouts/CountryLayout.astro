---
import Base from './Base.astro';
import InnerPageHero from '../components/InnerPageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import RegulatoryNotice from '../components/RegulatoryNotice.astro';
import ContactBanner from '../components/ContactBanner.astro';
import FeatureCard from '../components/FeatureCard.astro';
import RcicPartners from '../components/RcicPartners.astro';
import Icon from '../components/Icon.astro';
import CountryHelp from '../components/CountryHelp.astro';
import Button from '../components/Button.astro';
import { business } from '../data/business';
import type { Country } from '../data/countries';
import canadaHero from '../assets/editorial/canada-toronto-destination.webp';
import ukHero from '../assets/editorial/united-kingdom-london-destination.webp';
import nzHero from '../assets/editorial/new-zealand-queenstown-destination.webp';
import usaHero from '../assets/editorial/united-states-new-york-destination.webp';
import cyprusHero from '../assets/editorial/cyprus-mediterranean-destination.webp';
import italyHero from '../assets/editorial/italy-florence-destination.webp';
import netherlandsHero from '../assets/editorial/netherlands-amsterdam-destination.webp';
import russiaHero from '../assets/editorial/russia-saint-petersburg-destination.webp';
import czechHero from '../assets/editorial/czech-republic-prague-destination.webp';
import greeceHero from '../assets/editorial/greece-athens-destination.webp';
import mauritiusHero from '../assets/editorial/mauritius-le-morne-destination.webp';
interface Props { country: Country }
const { country: c } = Astro.props;
const xs: never[] = [];
const path = `/countries/${c.slug}/`;
const heroImages = {
  canada: { image: canadaHero, alt: 'Illustrative Toronto waterfront skyline with the CN Tower', social: '/social/canada-toronto-destination.webp' },
  uk: { image: ukHero, alt: 'Illustrative London view of Tower Bridge over the Thames', social: '/social/united-kingdom-london-destination.webp' },
  'new-zealand': { image: nzHero, alt: 'Illustrative Queenstown lake and mountain landscape', social: '/social/new-zealand-queenstown-destination.webp' },
  usa: { image: usaHero, alt: 'Illustrative Manhattan skyline across the Hudson River', social: '/social/united-states-new-york-destination.webp' },
  cyprus: { image: cyprusHero, alt: 'Illustrative Mediterranean coastal architecture in Cyprus', social: '/social/cyprus-mediterranean-destination.webp' },
  italy: { image: italyHero, alt: 'Illustrative Italian historic city street', social: '/social/italy-florence-destination.webp' },
  netherlands: { image: netherlandsHero, alt: 'Illustrative Dutch canal and gabled architecture', social: '/social/netherlands-amsterdam-destination.webp' },
  russia: { image: russiaHero, alt: 'Illustrative Saint Petersburg riverside architecture', social: '/social/russia-saint-petersburg-destination.webp' },
  'czech-republic': { image: czechHero, alt: 'Illustrative Prague historic bridge and cityscape', social: '/social/czech-republic-prague-destination.webp' },
  greece: { image: greeceHero, alt: 'Illustrative Athens city view with Acropolis', social: '/social/greece-athens-destination.webp' },
  mauritius: { image: mauritiusHero, alt: 'Illustrative Mauritian coastal landscape with Le Morne', social: '/social/mauritius-le-morne-destination.webp' },
};
const hero = heroImages[c.slug as keyof typeof heroImages];
const waHref = c.whatsappText ? `${business.whatsapp}?text=${encodeURIComponent(c.whatsappText)}` : business.whatsapp;
---
<Base title={c.seoTitle ?? `${c.name} Destination Information | NeoCAN Sri Ganganagar`} description={c.seoDescription ?? c.blurb} ogImage={hero?.social}>
  <InnerPageHero eyebrow="Destination" title={c.h1 ?? `${c.name}: information for applicants in India`} lead={c.answer ?? c.blurb} crumbs={[{ label: 'Countries', href: '/countries/' }, { label: c.name, href: path }]} icon="globe" tone={c.tone} chips={[c.name, 'Study, visit, tourist and PR help']} image={hero?.image} imageAlt={hero?.alt} cta={{ label: c.ctaLabel ?? 'Discuss your plans', href: c.ctaLabel ? '/contact/' : '/consultation/' }} cta2={{ label: 'Contact us', href: '/contact/' }} />

  <CountryHelp slug={c.slug} name={c.name} />

  <section class="section">
    <div class="container-x grid lg:grid-cols-2 gap-12 items-start">
      <div class="reveal"><SectionHeading eyebrow="Introduction" title={`About ${c.name} as a destination`} /><div class="prose-neo mt-5">{c.intro.map((p) => <p>{p}</p>)}</div></div>
      <div class="reveal space-y-4">
        <h2 class="t-card !text-2xl">Things to keep in mind</h2>
        {c.considerations.map((k) => <FeatureCard icon="info" title={k.title} text={k.text} />)}
      </div>
    </div>
  </section>

  {c.situations && (
    <section class="section section-soft">
      <div class="container-x">
        <SectionHeading eyebrow="Your plan" title={c.situationsTitle ?? `Which ${c.name} plan are you making?`} />
        <div class="mt-8 grid md:grid-cols-2 lg:grid-cols-3 gap-5">{c.situations.map((st) => <div class="card p-5 reveal"><h3 class="font-display font-bold text-ink">{st.title}</h3><p class="mt-2 text-[.9375rem]">{st.text}</p>{st.points && <ul class="ticks mt-4 space-y-2 text-[.9375rem]">{st.points.map((pt) => <li>{pt}</li>)}</ul>}</div>)}</div>
      </div>
    </section>
  )}

  {c.slug === 'canada' && <RcicPartners />}

  <section class="section section-mist">
    <div class="container-x grid lg:grid-cols-2 gap-10 items-center">
      <div><SectionHeading eyebrow="Discuss your case" title={`Talk to Aman Maan about your ${c.name} plan`} lead={`Call or WhatsApp to talk through your own situation: why you are considering ${c.name}, where you are in the process and what you already have. The steps above are the same for every applicant; your case decides which documents and appointments apply.`} />
        {c.askAman && <div class="mt-6 rounded-2xl bg-white border border-line p-5"><p class="font-display font-bold text-ink">{c.askTitle ?? `Things to talk through about ${c.name}`}</p><ul class="mt-2 space-y-1.5 list-disc pl-5 text-[.9375rem]">{c.askAman.map((q) => <li>{q}</li>)}</ul></div>}
        {c.whatsappText && <div class="mt-5"><Button href={waHref} external variant="primary" icon="whatsapp">WhatsApp about {c.name}</Button></div>}
      </div>
      <div class="card p-6 sm:p-8"><h2 class="t-card">{c.readyTitle ?? 'What to have ready'}</h2><p class="mt-3">{c.readyText ?? 'Your purpose, intended timing, education or work background where relevant, and any existing offer, application or refusal letter. Requirements differ by visa category; check official sources below before acting.'}</p><div class="mt-5"><a class="link-arrow" href="/consultation/">How consultations work <Icon name="arrow" size={16} /></a></div></div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <RelatedLinks title="Related NeoCAN pages" links={[{ label: 'Student Visa enquiries', href: '/services/study-visa/' }, { label: 'Visitor Visa and Tourist Visa enquiries', href: '/services/visitor-visa/' }, { label: 'IELTS preparation', href: '/services/ielts-coaching/' }, { label: 'Contact Aman Maan', href: '/contact/' }, ...(c.extraLinks ?? []), { label: 'All destination guides', href: '/countries/' }]} />
    </div>
  </section>

  {xs.length > 0 && (
    <section class="section">
      <div class="container-x">
        <RelatedLinks title={`${c.name}: specific guides`} links={xs.map((x) => ({ label: x.h1.split(':')[0], href: `/countries/${x.country}/${x.slug}/` }))} />
      </div>
    </section>
  )}

  <section class="section section-mist">
    <div class="container-x">
      <SectionHeading eyebrow="Process" title={c.processTitle ?? 'A general process'} align="center" />
      <div class="mt-12"><ProcessTimeline steps={c.process} /></div>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid lg:grid-cols-2 gap-12">
      <div>
        <h2 class="t-card !text-2xl">Official information</h2>
        <p class="mt-3 text-[.9375rem]">Visa rules change. Check the current requirements with the official authority before you act.</p>
        <ul class="mt-5 space-y-3">{c.official.map((o) => <li><a class="card hover flex items-center justify-between gap-3 px-5 py-4 font-display font-semibold text-navy" href={o.url} target="_blank" rel="noopener noreferrer"><span>{o.label}</span><Icon name="arrow" size={18} class="text-brand-strong" /></a></li>)}</ul>
        <div class="mt-6"><RegulatoryNotice kind={c.regulated} /></div>
      </div>
      <div><h2 class="t-card !text-2xl mb-5">{c.name} FAQs</h2><FAQAccordion items={c.faqs} schema />{c.ctaLabel && <div class="mt-8"><Button href="/contact/" variant="primary" arrow>{c.ctaLabel}</Button></div>}</div>
    </div>
  </section>
  <ContactBanner />
</Base>
