---
import Base from './Base.astro';
import InnerPageHero from '../components/InnerPageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import ContactBanner from '../components/ContactBanner.astro';
import Button from '../components/Button.astro';
import { business } from '../data/business';
import { getService } from '../data/services';
import { countries } from '../data/countries';
import type { Location } from '../data/locations';
interface Props { loc: Location }
const { loc } = Astro.props;
const svcs = loc.popularServices.map(getService).filter(Boolean);
const path = `/locations/${loc.slug}/`;
---
<Base title={`${loc.headline} | NeoCAN`} description={loc.description}>
  <InnerPageHero eyebrow={`${loc.name}, ${loc.state}`} title={loc.headline} lead={loc.description} crumbs={[{ label: 'Locations', href: '/locations/' }, { label: loc.name, href: path }]} icon="pin" tone="navy" chips={[loc.office ? 'Office location' : 'Enquire by phone']} cta={{ label: 'Contact NeoCAN', href: '/contact/' }} cta2={{ label: 'Call now', href: `tel:${business.phone}` }} />
  <section class="section">
    <div class="container-x grid lg:grid-cols-[1.2fr_1fr] gap-12">
      <div class="reveal">
        <SectionHeading eyebrow="Availability" title={loc.office ? 'Visit our Sri Ganganagar office' : `Support for ${loc.name} residents`} />
        <div class="prose-neo mt-5">{loc.about.map((p) => <p>{p}</p>)}</div>
        <div class="mt-6 rounded-2xl bg-soft border border-line p-5 text-[.9375rem]">
          <p class="font-display font-bold text-ink">{loc.office ? 'NeoCAN office' : 'Where NeoCAN is based'}</p>
          <p class="mt-1">{business.address.full}{loc.distance ? ` (${loc.distance})` : ''}</p>
          {!loc.office && <p class="mt-2">NeoCAN does not have an office or staff in {loc.name}.</p>}
        </div>
      </div>
      <div class="reveal space-y-4">{loc.angle.map((a) => <FeatureCard icon={loc.office ? 'building' : 'message'} title={a.title} text={a.text} />)}</div>
    </div>
  </section>
  <section class="section section-soft">
    <div class="container-x">
      <SectionHeading eyebrow="Services" title={`Popular enquiries from ${loc.name}`} />
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{svcs.map((s) => <ServiceCard service={s!} compact />)}</div>
    </div>
  </section>
  <section class="section">
    <div class="container-x grid lg:grid-cols-2 gap-12">
      <div><h2 class="t-card !text-2xl">Priority destinations</h2><p class="mt-3 text-[.9375rem]">Each destination has a general information guide. Ask Aman what help NeoCAN offers for your destination and case:</p>
        <ul class="mt-5 flex flex-wrap gap-2">{countries.map((c) => <li><a class="inline-block rounded-full border border-line px-4 py-2 text-sm font-semibold text-navy hover:bg-mist" href={`/countries/${c.slug}/`}>{c.name}</a></li>)}</ul></div>
      <div><h2 class="t-card !text-2xl mb-5">Questions from {loc.name}</h2><FAQAccordion items={loc.faqs} schema /></div>
    </div>
  </section>
  <section class="section section-mist"><div class="container-x grid lg:grid-cols-2 gap-10"><div><SectionHeading eyebrow="Your first conversation" title={`Contact Aman Maan from ${loc.name}`} lead="Aman Maan is NeoCAN's primary client contact. Tell him which service or destination you are considering and what stage you have reached." /></div><div class="card p-6"><h2 class="t-card">Prepare a useful enquiry</h2><p class="mt-3">Have your purpose, destination, relevant dates and any existing documents or decision letter in mind. NeoCAN's only physical office is in Sri Ganganagar. Ask the team to confirm the available discussion format before making plans to travel.</p><div class="mt-5"><Button href="/contact/" variant="secondary" arrow>Contact NeoCAN</Button></div></div></div></section>
  <section class="section section-mist"><div class="container-x"><RelatedLinks title="Related pages" links={[{ label: 'All services', href: '/services/' }, ...(loc.office ? [{ label: 'Applicants in Rajasthan', href: '/locations/rajasthan/', note: 'How to start from elsewhere in the state' }] : []), { label: 'Consultation', href: '/consultation/' }, { label: 'Contact NeoCAN', href: '/contact/' }]} /></div></section>
  <ContactBanner />
</Base>
