---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CountryCard from '../../components/CountryCard.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import Button from '../../components/Button.astro';
import { Image } from 'astro:assets';
import cyprusCard from '../../assets/editorial/cyprus-mediterranean-destination.webp';
import italyCard from '../../assets/editorial/italy-florence-destination.webp';
import netherlandsCard from '../../assets/editorial/netherlands-amsterdam-destination.webp';
import russiaCard from '../../assets/editorial/russia-saint-petersburg-destination.webp';
import czechrepublicCard from '../../assets/editorial/czech-republic-prague-destination.webp';
import greeceCard from '../../assets/editorial/greece-athens-destination.webp';
import mauritiusCard from '../../assets/editorial/mauritius-le-morne-destination.webp';
import { countries, pendingCountries, guideSlugByLabel } from '../../data/countries';
const faqs = [
  { q: 'Does a country guide mean NeoCAN can help me with that country?', a: 'No. A guide gives general information and official links. Tell Aman Maan your destination and purpose, and he will confirm what help NeoCAN offers for that country and your case.' },
  { q: 'How recent is the information in these guides?', a: 'Official pages were last reviewed on 13 November 2026. Visa rules, fees and appointment windows change, so confirm them on the official source before you act.' },
  { q: 'I have not chosen a country yet. Where should I start?', a: 'Tell Aman your purpose, such as study or a family visit, and your timing. He can point you to the official sources for the countries you are considering. The choice stays with you.' },
  { q: 'My country is not listed here. Can I still ask?', a: 'Yes. Ask Aman Maan whether NeoCAN can help with your destination and case.' },
];
const pendingImages: Record<string, ImageMetadata> = { 'Cyprus': cyprusCard, 'Italy': italyCard, 'Netherlands': netherlandsCard, 'Russia': russiaCard, 'Czech Republic (Czechia)': czechrepublicCard, 'Greece': greeceCard, 'Mauritius': mauritiusCard };
---
<PageLayout title="Study & Visit Visa Guides by Country | NeoCAN" description="Official-source guides to 11 destinations for study and visit plans from India. A guide does not confirm NeoCAN’s help for that country: ask Aman Maan." h1="Which country are you considering?" eyebrow="Countries" lead="Read the official basics for each destination, then tell Aman Maan your plan. He confirms what help NeoCAN offers for that country and your case." crumbs={[{ label: 'Countries', href: '/countries/' }]} icon="globe" cta={{ label: 'Discuss your destination with Aman Maan', href: '/contact/' }}>
  <section class="section"><div class="container-x">
    <SectionHeading eyebrow="Start here" title="Four detailed guides" lead="Canada, the United Kingdom, New Zealand and the United States have the most detailed guides, with study and visit basics, questions to ask Aman and official links. A guide does not confirm that NeoCAN offers every service for that country." />
    <div class="mt-9 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">{countries.filter((c) => !Object.values(guideSlugByLabel).includes(c.slug)).map((c) => <CountryCard country={c} />)}</div>
    <div class="mt-14"><SectionHeading eyebrow="More destinations" title="Further priority destinations" lead="General information drawn from official government pages. NeoCAN confirms the support available for your specific case when you enquire." /><ul class="mt-7 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">{pendingCountries.map((name) => <li class="card hover overflow-hidden"><a href={`/countries/${guideSlugByLabel[name]}/`} class="block">{pendingImages[name] && <Image src={pendingImages[name]} alt={`Illustrative ${name} destination view; not a NeoCAN office`} widths={[320,480,640]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" format="webp" quality={76} loading="lazy" class="block w-full aspect-[16/10] object-cover" />}<div class="p-5"><strong class="font-display text-navy">{name}</strong><span class="block mt-2 text-sm">Read the general guide</span></div></a></li>)}</ul></div>
  </div></section>
  <section class="section section-mist"><div class="container-x grid lg:grid-cols-[1fr_1.4fr] gap-12">
    <div><SectionHeading eyebrow="Before you choose" title="How to use these guides" lead="Each guide shows the official steps first, so you know what to check before you speak to anyone." /><div class="mt-6"><Button href="/contact/" variant="primary" arrow>Discuss your destination with Aman Maan</Button></div></div>
    <FAQAccordion items={faqs} schema />
  </div></section>
</PageLayout>
