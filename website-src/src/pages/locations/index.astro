---
import FAQAccordion from '../../components/FAQAccordion.astro';
import Button from '../../components/Button.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import { locations } from '../../data/locations';
import { business } from '../../data/business';
import { statePages } from '../../data/states';
const [office] = locations;
const hubFaqs = [
  { q: 'Does NeoCAN have an office in my city?', a: 'No. NeoCAN’s only office is in Sri Ganganagar, and there are no other offices or branches. You can still contact Aman Maan from anywhere in India by phone, WhatsApp or email.' },
  { q: 'I live in another state. Can I speak to Aman?', a: 'Call NeoCAN and ask to speak with Aman Maan. If you’d prefer an online consultation, ask Aman whether it’s available for your case.' },
  { q: 'What should I send in my first message?', a: 'Share your city and state, the help you need (student visa, visitor or tourist visa, IELTS or PR), your destination if you know it, and your timing. Please do not send passport scans, passwords or one-time codes in a first message.' },
];

---
<PageLayout title="NeoCAN Office in Sri Ganganagar | Locations & Contact" description="NeoCAN’s only office is in Sri Ganganagar, Rajasthan. Living elsewhere in India? Call and ask Aman Maan how you can discuss your plans." h1="Where is NeoCAN, and how can I reach Aman Maan?" eyebrow="Locations" lead="NeoCAN has one office, in Sri Ganganagar, Rajasthan. If you live in another city or state, call or WhatsApp Aman Maan and ask how you can discuss your plans." crumbs={[{ label: 'Locations', href: '/locations/' }]} icon="pin" chips={['Office: Sri Ganganagar', 'Enquire by phone']} cta={{ label: 'Discuss your plans with Aman Maan', href: '/contact/' }}>
  <section class="section">
    <div class="container-x">
      <a href={`/locations/${office.slug}/`} class="card hover block lg:flex overflow-hidden">
        <div class="hero-bg on-dark relative p-8 lg:p-12 lg:w-2/5 grid place-items-center text-center"><div class="absolute inset-0 dots opacity-25"></div><div class="relative"><Icon name="building" size={56} class="mx-auto text-coral" /><p class="mt-4 font-display font-extrabold text-2xl text-white">NeoCAN office</p></div></div>
        <div class="p-8 lg:p-12 flex-1">
          <p class="eyebrow">Physical office</p>
          <h2 class="t-card !text-3xl mt-3">{office.name}, {office.state}</h2>
          <p class="mt-3">{business.address.full}</p>
          <p class="mt-2">{business.hours}</p>
          <span class="link-arrow mt-6">Visit our Sri Ganganagar page<Icon name="arrow" size={18} /></span>
        </div>
      </a>

      {Object.values(statePages).length > 0 && (
        <div class="mt-8">
          <h2 class="t-card !text-2xl">Applicants by State or Union Territory</h2>
          <p class="mt-2">These pages explain how applicants in each place can start with Aman Maan. They are not offices. A State or Union Territory page is published only when we can verify local information that changes your next step. If yours is not listed, this page covers you: call or WhatsApp Aman Maan from anywhere in India.</p>
          <ul class="mt-4 flex flex-wrap gap-2">{Object.values(statePages).map((s) => <li><a class="inline-block rounded-full border border-line px-5 py-3 text-sm font-semibold text-navy hover:bg-mist" href={`/locations/${s.slug}/`}>{s.name}</a></li>)}</ul>
        </div>
      )}

      <p class="mt-8">For enquiries from elsewhere in India, contact the Sri Ganganagar office to ask what discussion format is available.</p>
      <a href={business.maps} target="_blank" rel="noopener noreferrer" class="link-arrow mt-4">Google Maps directions →</a>
    </div>
  </section>
  <section class="section section-mist"><div class="container-x grid lg:grid-cols-[1fr_1.4fr] gap-12">
    <div><SectionHeading eyebrow="Outside Sri Ganganagar" title="If you live elsewhere in India" lead="You do not need to travel before you speak to Aman. Start with a call or message and ask what is possible for your case." />
      <ol class="mt-6 space-y-3 list-decimal pl-5"><li>Call or WhatsApp +91 99505 29700, or email contact@neocan.net.</li><li>Tell Aman your city and state, the help you need and your timing.</li><li>Ask whether an online consultation is available for your case.</li></ol>
      <div class="mt-6 flex flex-wrap gap-3"><Button href={business.whatsapp + '?text=' + encodeURIComponent('Hello NeoCAN, I live outside Sri Ganganagar and would like to speak to Aman Maan. City and state: ... Help I need (student visa / visitor visa / IELTS / PR): ... Destination (if known): ... Timing: ...')} external variant="primary" icon="whatsapp">WhatsApp from your city</Button><Button href="/services/" variant="secondary" arrow>See the services</Button></div>
    </div>
    <FAQAccordion items={hubFaqs} schema />
  </div></section>
</PageLayout>
