---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import HomeHeroCarousel from '../components/HomeHeroCarousel.astro';
import studyVisaImage from '../assets/editorial/student-visa-assistance-india.webp';
import ieltsImage from '../assets/editorial/ielts-preparation-student.webp';
import prImage from '../assets/editorial/permanent-residency-information.webp';
import visitorImage from '../assets/editorial/visitor-tourist-visa-planning.webp';
import canadaImage from '../assets/editorial/canada-toronto-destination.webp';
import ukImage from '../assets/editorial/united-kingdom-london-destination.webp';
import nzImage from '../assets/editorial/new-zealand-queenstown-destination.webp';
import usaImage from '../assets/editorial/united-states-new-york-destination.webp';
import cyprusCard from '../assets/editorial/cyprus-mediterranean-destination.webp';
import italyCard from '../assets/editorial/italy-florence-destination.webp';
import netherlandsCard from '../assets/editorial/netherlands-amsterdam-destination.webp';
import russiaCard from '../assets/editorial/russia-saint-petersburg-destination.webp';
import czechrepublicCard from '../assets/editorial/czech-republic-prague-destination.webp';
import greeceCard from '../assets/editorial/greece-athens-destination.webp';
import mauritiusCard from '../assets/editorial/mauritius-le-morne-destination.webp';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import AmanPortrait from '../components/AmanPortrait.astro';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';
import OfficeLocation from '../components/OfficeLocation.astro';
import RcicPartners from '../components/RcicPartners.astro';
import { business } from '../data/business';
import { countries } from '../data/countries';
import { homeFaqs } from '../data/faqs';
const routes = [
  { label: 'Student Visa', href: '/services/study-visa/', image: studyVisaImage, alt: 'Illustrative Indian student planning overseas study', status: 'I want to study abroad', text: 'Discuss your study plan and how your documents can be organised against the official requirements of your destination.' },
  { label: 'Visitor Visa & Tourist Visa', href: '/services/visitor-visa/', image: visitorImage, alt: 'Illustrative family planning a short personal visit', status: 'I want to visit family or travel', text: 'Talk through your itinerary or invitation and the documents the destination authority asks for. One page covers both visitor and tourist visa enquiries.' },
  { label: 'PR (Permanent Residency)', href: '/services/pr/', image: prImage, alt: 'Illustrative couple considering long-term relocation plans', status: 'I am thinking about PR', text: 'Aman Maan personally handles PR enquiries and coordinates the work. For Canadian immigration matters, NeoCAN works with a Regulated Canadian Immigration Consultant (RCIC) partner.', cta: 'Discuss your PR plans with Aman Maan' },
  { label: 'IELTS', href: '/services/ielts-coaching/', image: ieltsImage, alt: 'Illustrative student preparing for the IELTS test', status: 'I need IELTS preparation', text: 'Ask about preparing for Listening, Reading, Writing and Speaking. NeoCAN is not an IELTS test centre; book the test with the official provider.' },
];
const pendingImages: Record<string, ImageMetadata> = { 'Cyprus': cyprusCard, 'Italy': italyCard, 'Netherlands': netherlandsCard, 'Russia': russiaCard, 'Czech Republic (Czechia)': czechrepublicCard, 'Greece': greeceCard, 'Mauritius': mauritiusCard };
const destinationImages = { canada: canadaImage, uk: ukImage, 'new-zealand': nzImage, usa: usaImage };
const destinationDescriptions: Record<string, string> = {
  canada: 'Study permits begin with an acceptance letter from a designated learning institution.',
  uk: 'Student visa applications require a CAS from a licensed education sponsor.',
  'new-zealand': 'Student visa planning starts with an offer of place from an approved provider.',
  usa: 'F-1 study plans involve a school-issued Form I-20 and a visa application.',
  cyprus: 'Non-EU students need an entry permit and a residence permit after arrival.',
  italy: 'Short Schengen stays and longer national stays use different visa categories.',
  netherlands: 'For higher education, the institution applies for the student residence permit.',
  russia: 'Check the official e-visa portal and current travel advisories before planning.',
  'czech-republic': 'Study stays over three months use long-term visa or residence pathways.',
  greece: 'Check Greek Schengen visa requirements when planning a short visit.',
  mauritius: 'Visitors need a return ticket, adequate funds and confirmed accommodation.',
};
---
<Base title="Student Visa, Visitor Visa & IELTS | NeoCAN Sri Ganganagar" description="Visit NeoCAN at 69, H Block, Sri Ganganagar for student visa, visitor visa, IELTS and PR enquiries. Speak with Aman Maan by call, WhatsApp or in person." ogImage="/social/neocan-homepage-study-visa-support.webp">
  <SchemaLocalBusiness />
  <div id="home-page">
    <div class="home-hero-shell"><HomeHeroCarousel /></div>

  <section class="section section-soft" id="priority-services"><div class="container-x">
    <SectionHeading eyebrow="Where to start" title="Choose the help you need" lead="Pick the goal closest to yours. Each page explains what NeoCAN helps with and what to have ready." />
    <div class="mt-8 grid sm:grid-cols-2 xl:grid-cols-4 gap-4">
      {routes.map((r) => <a href={r.href} class="card hover flex flex-col overflow-hidden h-full"><Image src={r.image} alt={r.alt} widths={[360,540,720]} sizes="(min-width: 1280px) 280px, (min-width: 640px) 50vw, 100vw" format="webp" quality={78} loading="lazy" class="block w-full aspect-[16/9] object-cover" /><div class="p-5 flex-1"><span class="text-xs font-bold uppercase tracking-wider text-brand-strong">{r.status}</span><h3 class="t-card mt-3">{r.label}</h3><p class="mt-3 text-sm">{r.text}</p>{r.cta && <span class="link-arrow mt-4">{r.cta} →</span>}</div></a>)}
    </div>
    <p class="mt-6 text-sm">Not sure which applies, or your goal is different? <a href="/contact/" class="text-brand-strong underline">Contact NeoCAN</a> and describe your plan. See <a href="/services/" class="text-brand-strong underline">all service information</a>.</p>
  </div></section>

  <section class="section" id="destinations"><div class="container-x">
    <SectionHeading title="Destinations you can ask about" lead="Each guide gives general information and links to the official authority. NeoCAN confirms which services it can help with for your destination when you enquire." />
    <ul class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {countries.map((c) => {
        const image = destinationImages[c.slug as keyof typeof destinationImages] ?? pendingImages[c.name];
        const alt = `Illustrative ${c.name} destination view; not a NeoCAN office`;
        return <li class="h-full"><a href={`/countries/${c.slug}/`} class="card hover flex flex-col overflow-hidden h-full">
          {image && <Image src={image} alt={alt} widths={[320,480,640]} sizes="(min-width: 1280px) 280px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" format="webp" quality={76} loading="lazy" class="block w-full aspect-[16/9] object-cover" />}
          <div class="p-4 sm:p-5 flex-1"><h3 class="font-display text-lg font-bold text-navy">{c.name}</h3><p class="text-sm mt-2">{destinationDescriptions[c.slug]}</p></div>
        </a></li>;
      })}
    </ul>
    <p class="mt-5 text-sm">A country page does not confirm that NeoCAN offers a specific service or visa route there. <a href="/countries/" class="text-brand-strong underline">View the destination directory</a>.</p>
  </div></section>

  <RcicPartners />

  <section class="section section-mist"><div class="container-x grid lg:grid-cols-2 gap-12 items-start">
    <div><SectionHeading eyebrow="How enquiries work" title="Your first enquiry, step by step" lead="Aman Maan oversees the conversation and follow-up." /><ol class="mt-7 space-y-4 list-decimal pl-5"><li><strong>Contact us.</strong> Call, WhatsApp, email or visit the office.</li><li><strong>Explain your plan.</strong> Aman listens to what you want to do, where and by when.</li><li><strong>Confirm what applies.</strong> He explains which NeoCAN services fit and which official sources to read.</li><li><strong>Agree the next step.</strong> You leave with a list of documents to start on and a follow-up plan.</li></ol><div class="mt-7"><Button href="/consultation/" variant="secondary" arrow>How a consultation works</Button></div></div>
    <div class="card p-7"><h3 class="t-card">What to mention in your first message</h3><ul class="mt-4 space-y-2 list-disc pl-5"><li>The help you need: student visa, visitor or tourist visa, IELTS or PR</li><li>Your destination country, or that you have not chosen yet</li><li>Your city and the timing you have in mind</li><li>A line or two about your situation, for example “offer letter received”</li></ul><p class="mt-4 text-sm">Please do not send passport scans, passwords or one-time codes in a first message. Aman will tell you how to share documents. Ask about a phone or online discussion if you cannot visit; availability is confirmed for each case.</p><p class="mt-4 text-sm">NeoCAN does not guarantee any visa decision or IELTS score. The destination authority decides every application.</p></div>
  </div></section>

  <section class="section"><div class="container-x grid lg:grid-cols-[2fr_3fr] gap-12 items-center"><AmanPortrait /><div><SectionHeading eyebrow="Your contact" title="Meet Aman Maan" lead="Direct client communication and daily operational supervision." /><p class="mt-5">Aman Maan speaks with clients, listens to their requirements, coordinates enquiries and service-related work, and oversees customer follow-up. The NeoCAN team works under his operational supervision.</p><div class="mt-7"><Button href="/about/aman-maan/" variant="secondary" arrow>About Aman Maan</Button></div></div></div></section>

  <OfficeLocation />

  <section class="section"><div class="container-x grid lg:grid-cols-[1fr_1.4fr] gap-12"><SectionHeading eyebrow="Questions" title="Frequently asked questions" lead="Short answers about availability, destinations and contact." /><FAQAccordion items={homeFaqs} schema /></div></section>
  <section class="hero-bg on-dark"><div class="container-x py-10 sm:py-12 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-7"><div><h2 class="font-display text-white text-3xl font-bold">Start with a direct conversation</h2><p class="text-slate-300 mt-2">Tell Aman Maan your service, destination, city and timing. {business.hours}.</p></div><div class="flex flex-wrap gap-3"><Button href={`tel:${business.phone}`} variant="primary">Call</Button><Button href={business.whatsapp} external variant="outline-light">WhatsApp</Button><Button href="/contact/" variant="outline-light">Contact</Button></div></div></section>
  </div>
</Base>

<style is:global>
  #home-page .home-hero-shell { max-width: 1240px; margin: 1.5rem auto 0; padding-inline: 1rem; }
  #home-page .home-carousel { min-height: 0; border-radius: 1.5rem; box-shadow: 0 20px 48px rgba(7, 31, 73, .14); }
  #home-page .home-carousel .hero-inner { min-height: 500px; }
  #home-page .home-carousel .hero-copy { padding-block: 3.25rem 2.75rem; }
  #home-page .home-carousel h1 { font-size: clamp(2.35rem, 3.7vw, 3.45rem); }
  #home-page .home-carousel .hero-description { margin-top: 1.4rem; font-size: 1rem; }
  #home-page .home-carousel .hero-actions { margin-top: 1.5rem; gap: .85rem; }
  #home-page .home-carousel .hero-note { margin-top: 1rem; }
  #home-page .home-carousel .hero-art { min-height: 500px; }
  #home-page .home-carousel .hero-art img { max-height: 490px; }
  #home-page .section { padding-block: 3.5rem; }
  #home-page #visit-neocan iframe { min-height: 420px; }
  @media (min-width: 1024px) {
    #home-page .section { padding-block: 4.5rem; }
  }
  @media (max-width: 900px) {
    #home-page .home-carousel .hero-inner { min-height: 0; }
    #home-page .home-carousel .hero-copy { padding: 3.25rem 0 0; }
    #home-page .home-carousel .hero-art { min-height: 320px; }
    #home-page .home-carousel .hero-art img { max-height: 320px; }
  }
  @media (max-width: 600px) {
    #home-page .home-hero-shell { margin-top: .75rem; padding-inline: .75rem; }
    #home-page .home-carousel { border-radius: 1.125rem; }
    #home-page .home-carousel .hero-copy { padding-top: 2.25rem; }
    #home-page .home-carousel h1 { font-size: clamp(2rem, 8vw, 2.7rem); }
    #home-page .home-carousel .hero-art { min-height: 240px; }
    #home-page .home-carousel .hero-art img { max-height: 240px; }
    #home-page .section { padding-block: 2.75rem; }
  }
</style>
