---
import PageLayout from '../../layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import studyVisaImage from '../../assets/editorial/student-visa-assistance-india.webp';
import ieltsImage from '../../assets/editorial/ielts-preparation-student.webp';
import visitorImage from '../../assets/editorial/visitor-tourist-visa-planning.webp';
import immigrationImage from '../../assets/editorial/immigration-planning-enquiry.webp';
import visaImage from '../../assets/editorial/visa-planning-documents.webp';
import prImage from '../../assets/editorial/permanent-residency-information.webp';
import touristImage from '../../assets/editorial/tourist-visa-travel-planning.webp';
import RcicPartners from '../../components/RcicPartners.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { priorityServices } from '../../data/services';
import { countries } from '../../data/countries';
const serviceFaqs = [
  { q: 'Which NeoCAN service should I ask about first?', a: 'Start with your goal. For study abroad ask about Student Visa; if you need an English test score ask about IELTS; for a short trip or family visit ask about Visitor Visa or Tourist Visa; for permanent residency discuss your PR plans with Aman Maan. If you are unsure, tell Aman your purpose and destination and he will point you to the right discussion.' },
  { q: 'What do the Immigration and Visa enquiries cover?', a: 'These are general starting points for situations that do not fit a service page. Aman Maan listens to your situation and confirms whether NeoCAN can assist and what the tasks would be. Regulated advice must come from a person authorised in the destination country.' },
  { q: 'Is there a separate Tourist Visa page?', a: 'No. Visitor Visa and Tourist Visa enquiries share one page because the support discussed is the same. The official visa category depends on the destination and your purpose.' },
  { q: 'Can NeoCAN help with PR (Permanent Residency)?', a: 'Yes. Aman Maan personally handles PR enquiries, discusses your requirements and coordinates the work. For Canadian immigration matters, NeoCAN works with a Regulated Canadian Immigration Consultant (RCIC) partner. Ask Aman what support is available for your destination and case.' },
  { q: 'Can NeoCAN help me fill in my visa form, and who will submit it?', a: 'Ask Aman whether NeoCAN can help with the form for your service and destination. Also confirm who will submit the application.' },
  { q: 'When will I know what the help will cost?', a: 'Before agreeing to paid work, ask Aman what NeoCAN will charge for your case and what that fee includes. Ask separately about any official fees you will pay to the authority.' },
  { q: 'I live outside Sri Ganganagar. Can I speak to Aman?', a: 'Call NeoCAN and ask to speak with Aman Maan. If you’d prefer an online consultation, ask Aman whether it’s available for your case.' },
];
const serviceImages: Record<string, ImageMetadata> = { Immigration: immigrationImage, Visa: visaImage, IELTS: ieltsImage, 'Student Visa': studyVisaImage, 'PR (Permanent Residency)': prImage, 'Visitor Visa': visitorImage, 'Tourist Visa': touristImage };
const serviceAlts: Record<string, string> = { Immigration: 'Illustrative applicant researching options for a longer move abroad', Visa: 'Illustrative applicant reviewing travel dates and blank planning documents', IELTS: 'Illustrative student preparing for the IELTS test', 'Student Visa': 'Illustrative Indian student planning overseas study', 'PR (Permanent Residency)': 'Illustrative couple considering long-term relocation plans', 'Visitor Visa': 'Illustrative family planning a short personal visit', 'Tourist Visa': 'Illustrative traveller planning a leisure trip with a map' };
---
<PageLayout title="Visa, IELTS & PR Services in Sri Ganganagar | NeoCAN" description="See how NeoCAN in Sri Ganganagar can help with student visa, visitor and tourist visa, IELTS preparation and PR. Find your service and talk to Aman Maan." h1="Which NeoCAN service do you need?" eyebrow="Services" lead="Student visa, visitor and tourist visa, IELTS preparation and PR enquiries start with a conversation with Aman Maan in Sri Ganganagar. Pick the goal closest to yours, or ask him if you are not sure." crumbs={[{ label: 'Services', href: '/services/' }]} icon="message" cta={{ label: 'Discuss your plans with Aman Maan', href: '/contact/' }}>
  <section class="section"><div class="container-x">
    <SectionHeading eyebrow="Our services" title="Choose your enquiry area" lead="Student Visa, IELTS, Visitor Visa and Tourist Visa have their own information pages, and PR has its own page. Immigration and Visa are starting points for other enquiries, and the tasks are confirmed individually." />
    <div class="mt-10"><SectionHeading eyebrow="Start from your goal" title="Which service matches what you need?" /><ul class="mt-7 grid md:grid-cols-2 gap-4">
      <li class="card p-5"><strong class="font-display text-navy">I want to study abroad</strong><p class="mt-2 text-sm">Ask about <a class="text-brand-strong underline" href="/services/study-visa/">Student Visa</a>. If your institution asks for an English test, add <a class="text-brand-strong underline" href="/services/ielts-coaching/">IELTS</a>.</p></li>
      <li class="card p-5"><strong class="font-display text-navy">I need an IELTS score</strong><p class="mt-2 text-sm">Ask about <a class="text-brand-strong underline" href="/services/ielts-coaching/">IELTS preparation</a> and read the <a class="text-brand-strong underline" href="/resources/ielts-preparation/">IELTS starter guide</a>.</p></li>
      <li class="card p-5"><strong class="font-display text-navy">I am planning a short trip or family visit</strong><p class="mt-2 text-sm">Ask about <a class="text-brand-strong underline" href="/services/visitor-visa/">Visitor Visa and Tourist Visa</a>.</p></li>
      <li class="card p-5"><strong class="font-display text-navy">I am thinking about PR</strong><p class="mt-2 text-sm">Read about <a class="text-brand-strong underline" href="/services/pr/">PR enquiries</a>, or <a class="text-brand-strong underline" href="/contact/">discuss your PR plans with Aman Maan</a>. For Canadian immigration matters, NeoCAN works with a Regulated Canadian Immigration Consultant (RCIC) partner.</p></li>
      <li class="card p-5"><strong class="font-display text-navy">I am not sure which visa I need</strong><p class="mt-2 text-sm">Tell Aman Maan your purpose and destination through the <a class="text-brand-strong underline" href="/contact/">contact page</a>. Check the official authority for the right category.</p></li>
    </ul></div>
    <div class="mt-14"><SectionHeading eyebrow="All services" title="Every service at a glance" lead="Each card says what the help is and links to the page where you can read more or start an enquiry." /></div>
    <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {priorityServices.map((s) => { const image = serviceImages[s.label as keyof typeof serviceImages]; return <article id={s.label === 'Immigration' ? 'immigration' : s.label === 'Visa' ? 'visa' : s.label.startsWith('PR ') ? 'pr' : s.label === 'IELTS' ? 'language' : s.label === 'Student Visa' ? 'study' : s.label === 'Visitor Visa' ? 'visitor' : undefined} class="card overflow-hidden scroll-mt-32">{image && <Image src={image} alt={serviceAlts[s.label]} widths={[360,540,720]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" format="webp" quality={78} loading="lazy" class="block w-full aspect-[16/10] object-cover" />}<div class="p-6"><p class="text-xs font-bold uppercase tracking-wider text-brand-strong">{s.status}</p><h2 class="t-card mt-3">{s.label}</h2><p class="mt-3 text-sm">{s.text}</p>{!s.href.includes('#') && <a class="link-arrow mt-5" href={s.href}>Read the guide →</a>}{s.more && <a class="link-arrow mt-5" href={s.more.href}>{s.more.label} →</a>}{s.cta && <a class="link-arrow mt-5" href={s.cta.href}>{s.cta.label} →</a>}</div></article>; })}
    </div>
    <div class="mt-14"><SectionHeading eyebrow="Umbrella enquiries" title="How Immigration and Visa enquiries work" lead="These two areas are starting points. They are not a promise of any specific service." />
      <div class="mt-7 grid md:grid-cols-2 gap-5">
        <div class="card p-6"><h3 class="t-card">Immigration</h3><p class="mt-3 text-sm">Use this when you are considering a longer move or stay abroad. Aman Maan listens to your situation, points you to the official authority and visa categories to check for your destination, and coordinates a discussion with the NeoCAN team. In that discussion NeoCAN confirms which tasks it can carry out and any fee. This page does not advertise legal advice, eligibility opinions or representation.</p></div>
        <div class="card p-6"><h3 class="t-card">Visa</h3><p class="mt-3 text-sm">Use this when you are not sure which visa fits. Tell Aman Maan your purpose, destination and timing. He directs you to the matching NeoCAN page, <a class="text-brand-strong underline" href="/services/study-visa/">Student Visa</a> or <a class="text-brand-strong underline" href="/services/visitor-visa/">Visitor and Tourist Visa</a>, and to the official source for the destination, and oversees follow-up.</p></div>
      </div>
      <p class="mt-6 text-sm">Official information by destination: {countries.map((c, i) => <><a class="text-brand-strong underline" href={`/countries/${c.slug}/`}>{c.name}</a>{i < countries.length - 1 ? ', ' : '.'}</>)}</p>
    </div>
    <div class="mt-14 grid lg:grid-cols-[1fr_1.4fr] gap-12"><SectionHeading eyebrow="Questions" title="Service FAQs" lead="Short answers about what NeoCAN can and cannot do." /><FAQAccordion items={serviceFaqs} schema /></div>
    <div class="mt-10 rounded-2xl bg-mist p-6"><h2 class="t-card">Before you enquire</h2><p class="mt-3">Tell Aman Maan your destination and purpose. The team will confirm what tasks it can perform for your destination and case, and any fee. For Canadian immigration matters, NeoCAN works with an RCIC partner.</p></div>
  </div></section>
  <RcicPartners tone="light" />
</PageLayout>
