---
import Illustration from './Illustration.astro';
import { Image } from 'astro:assets';
import ieltsGuide from '../assets/editorial/ielts-preparation-four-skills-guide.webp';
import checklistGuide from '../assets/editorial/study-visa-document-checklist-guide.webp';
import Icon from './Icon.astro';
import type { Resource } from '../data/resources';
interface Props { resource: Resource }
const { resource: r } = Astro.props;
const image = ({ 'ielts-preparation': ieltsGuide, 'study-visa-checklist': checklistGuide } as Record<string, typeof ieltsGuide>)[r.slug];
---
<a href={`/resources/${r.slug}/`} class="card group flex flex-col overflow-hidden h-full" data-category={r.category}>
  {image ? <Image src={image} alt={`Illustrative visual for ${r.title.toLowerCase()}`} widths={[360,540,720]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" format="webp" quality={78} loading="lazy" decoding="async" class="block w-full aspect-[16/9] object-cover" /> : <Illustration icon={r.icon} tone={r.tone} ratio="aspect-[16/9]" class="!rounded-none" />}
  <div class="p-6 flex flex-col flex-1">
    <p class="text-xs font-bold uppercase tracking-wider text-brand-strong">{r.category}</p>
    <h3 class="t-card mt-2">{r.title}</h3>
    <p class="mt-3 text-[.9375rem] flex-1">{r.excerpt}</p>
    <span class="link-arrow mt-5">Read more<Icon name="arrow" size={18} /></span>
  </div>
</a>
