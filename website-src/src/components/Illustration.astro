---
// Original NeoCAN vector illustration panel (no stock imagery). Replace with licensed/approved photography when available.
import Icon from './Icon.astro';
interface Props { icon?: string; tone?: 'navy' | 'red' | 'light'; label?: string; chips?: string[]; class?: string; ratio?: string }
const { icon = 'globe', tone = 'navy', label, chips = [], class: cls = '', ratio = 'aspect-[4/3]' } = Astro.props;
const bg = {
  navy: 'bg-[linear-gradient(135deg,#03152f,#123068)] text-white',
  red: 'bg-[linear-gradient(135deg,#a81b22,#e93435)] text-white',
  light: 'bg-[linear-gradient(135deg,#edf2f8,#dbe5f3)] text-navy',
}[tone];
const ring = tone === 'light' ? 'rgba(7,31,73,.14)' : 'rgba(255,255,255,.2)';
const dot = tone === 'light' ? '#c8232b' : '#fff';
---
<div class={`relative overflow-hidden rounded-2xl ${ratio} ${bg} ${cls}`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <svg class="absolute inset-0 w-full h-full" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g fill="none" stroke={ring} stroke-width="1.5">
      <circle cx="300" cy="90" r="150" /><circle cx="300" cy="90" r="110" /><circle cx="300" cy="90" r="70" />
      <ellipse cx="300" cy="90" rx="150" ry="55" /><ellipse cx="300" cy="90" rx="55" ry="150" />
    </g>
    <path class="route-dash" d="M30 250 C 120 130, 220 230, 340 70" fill="none" stroke={ring} stroke-width="2.5" />
    <circle cx="30" cy="250" r="5" fill={dot} /><circle cx="340" cy="70" r="5" fill={dot} />
  </svg>
  <div class="absolute inset-0 dots opacity-40" aria-hidden="true"></div>
  <div class="absolute inset-0 flex items-center justify-center">
    <div class={`floaty grid place-items-center rounded-3xl w-24 h-24 sm:w-28 sm:h-28 ${tone === 'light' ? 'bg-white text-brand-strong shadow-card' : 'bg-white/10 backdrop-blur ring-1 ring-white/30'}`}>
      <Icon name={icon} size={52} />
    </div>
  </div>
  {chips.length > 0 && (
    <div class="absolute left-3 bottom-3 right-3 flex flex-wrap gap-2">
      {chips.map((c) => <span class={`text-xs font-semibold px-3 py-1.5 rounded-full ${tone === 'light' ? 'bg-white text-navy' : 'bg-white/15 text-white ring-1 ring-white/25'}`}>{c}</span>)}
    </div>
  )}
</div>
