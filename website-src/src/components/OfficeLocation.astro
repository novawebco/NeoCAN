---
import { Image } from 'astro:assets';
import logo from '../assets/branding/neocan-logo-header.webp';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { business } from '../data/business';
---
<section class="section section-soft" id="visit-neocan">
  <div class="container-x">
    <SectionHeading eyebrow="Visit or call" title="Visit NeoCAN Global Migration Consulting in Sri Ganganagar" lead="Connect with NeoCAN in Sri Ganganagar. Speak directly with Aman Maan about your student visa, visitor or tourist visa, IELTS or PR enquiry." />
    <div class="mt-9 grid lg:grid-cols-2 gap-6 lg:gap-8 items-stretch">
      <div class="card p-6 sm:p-8 lg:p-9 min-w-0">
        <div class="flex flex-wrap items-center gap-4 border-b border-line pb-6">
          <div class="rounded-xl bg-white border border-line p-2"><Image src={logo} alt="NeoCAN Global Migration Consulting logo" width={220} height={44} class="block w-[220px] max-w-full h-auto" /></div>
          <div><h3 class="font-display text-xl font-bold text-navy">{business.name}</h3><p class="text-sm">Sri Ganganagar office</p></div>
        </div>
        <dl class="mt-6 space-y-5">
          <div class="flex gap-4"><Icon name="users" size={22} class="mt-0.5 text-brand-strong flex-none" /><div><dt class="font-display font-bold text-ink">Primary contact</dt><dd>{business.contactPerson.name} · Primary Contact &amp; Operations</dd></div></div>
          <div class="flex gap-4"><Icon name="pin" size={22} class="mt-0.5 text-brand-strong flex-none" /><div><dt class="font-display font-bold text-ink">Office address</dt><dd><address class="not-italic">{business.address.full}</address></dd></div></div>
          <div class="flex gap-4"><Icon name="clock" size={22} class="mt-0.5 text-brand-strong flex-none" /><div><dt class="font-display font-bold text-ink">Opening hours</dt><dd>{business.hours}</dd></div></div>
          <div class="flex gap-4"><Icon name="phone" size={22} class="mt-0.5 text-brand-strong flex-none" /><div><dt class="font-display font-bold text-ink">Phone</dt><dd><a class="text-brand-strong underline underline-offset-2" href={`tel:${business.phone}`}>{business.phoneDisplay}</a></dd></div></div>
          <div class="flex gap-4"><Icon name="mail" size={22} class="mt-0.5 text-brand-strong flex-none" /><div><dt class="font-display font-bold text-ink">Email</dt><dd><a class="text-brand-strong underline underline-offset-2 break-all" href={`mailto:${business.email}`}>{business.email}</a></dd></div></div>
        </dl>
        <div class="mt-7 flex flex-wrap gap-3"><Button href={business.maps} external variant="secondary" icon="route">Get Directions</Button><Button href={`tel:${business.phone}`} variant="primary" icon="phone">Call Now</Button></div>
        <a href={business.maps} target="_blank" rel="noopener noreferrer" class="link-arrow mt-5">View Google reviews <Icon name="arrow" size={18} /></a>
      </div>
      <div class="card overflow-hidden flex flex-col min-w-0">
        <iframe src={business.mapEmbed} title="NeoCAN Global Migration Consulting office location on Google Maps" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen class="block w-full h-[340px] sm:h-[390px] lg:h-full lg:min-h-[500px] border-0" />
        <div class="px-5 py-4 border-t border-line"><a href={business.maps} target="_blank" rel="noopener noreferrer" class="link-arrow">Open in Google Maps <Icon name="arrow" size={18} /></a></div>
      </div>
    </div>
  </div>
</section>
