---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import { countryHelp, serviceGroups, countryRoleAnswers } from '../data/countryHelp';
import { ROLES_HEADING } from '../data/applicationRoles';
import { business } from '../data/business';
interface Props { slug: string; name: string }
const { slug, name } = Astro.props;
const h = countryHelp[slug];
const roles = h ? countryRoleAnswers(slug) : [];
const goals = h ? [
  { goal: 'I want to study', route: h.study },
  { goal: 'I want to visit family', route: h.visit },
  { goal: 'I want to travel as a tourist', route: h.tourist },
  { goal: 'I want to explore permanent residency', route: h.pr },
] : [];
---
{h && (
  <>
  <section class="section section-soft" id="how-neocan-helps">
    <div class="container-x">
      <SectionHeading eyebrow="How NeoCAN helps" title={`What NeoCAN can do for your ${name} plan`} lead={`NeoCAN helps people in India who want to study, visit family, travel as a tourist or explore permanent residency in ${name}. Aman Maan personally oversees your application. We’ll review your documents and help prepare your application forms.`} />
      <div class="mt-8 grid md:grid-cols-2 gap-5">
        {goals.map((g) => (
          <div class="card p-5 reveal">
            <p class="text-sm font-semibold text-brand-strong">{g.goal}</p>
            <h3 class="mt-1 font-display font-bold text-ink">{g.route.name}</h3>
            <p class="mt-2 text-[.9375rem]">{g.route.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-6 grid md:grid-cols-3 gap-5">
        <div class="card p-5 reveal">
          <h3 class="font-display font-bold text-ink">{serviceGroups.immigration}</h3>
          <ul class="ticks mt-3 space-y-2 text-[.9375rem]"><li>Permanent Residency (PR) assistance</li></ul>
        </div>
        <div class="card p-5 reveal">
          <h3 class="font-display font-bold text-ink">{serviceGroups.visa}</h3>
          <ul class="ticks mt-3 space-y-2 text-[.9375rem]"><li>Student Visa assistance</li><li>Visitor Visa assistance</li><li>Tourist Visa assistance</li></ul>
        </div>
        <div class="card p-5 reveal">
          <h3 class="font-display font-bold text-ink">{serviceGroups.ielts}</h3>
          <p class="mt-3 text-[.9375rem]">{h.ielts}</p>
        </div>
      </div>
      {h.notice && <p class="mt-6 text-[.9375rem] rounded-2xl bg-white border border-line p-5">{h.notice}</p>}
    </div>
  </section>
  <section class="section" id="who-does-what">
    <div class="container-x">
      <SectionHeading eyebrow="Your application" title={ROLES_HEADING} />
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {roles.map((r) => (
          <div class="card p-5 reveal">
            <h3 class="font-display font-bold text-ink">{r.q}</h3>
            <p class="mt-2 text-[.9375rem]">{r.a}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 text-[.9375rem]">Want to talk about your own case? Call or WhatsApp NeoCAN and ask for Aman Maan. Every case is different, so he will tell you which documents to provide and which steps apply to you.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <Button href={`tel:${business.phone}`} variant="primary" icon="phone">Call {business.phoneDisplay}</Button>
        <Button href={business.whatsapp} external variant="secondary" icon="whatsapp">WhatsApp Aman Maan<span class="sr-only"> (opens in a new tab)</span></Button>
      </div>
    </div>
  </section>
  </>
)}
