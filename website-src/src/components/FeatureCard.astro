---
import Icon from './Icon.astro';
interface Props { icon: string; title: string; text: string; dark?: boolean }
const { icon, title, text, dark = false } = Astro.props;
---
<div class={`rounded-2xl p-6 ${dark ? 'bg-white/8 ring-1 ring-white/15 on-dark' : 'card'}`}>
  <span class={`grid place-items-center w-12 h-12 rounded-xl ${dark ? 'bg-white/12 text-coral' : 'bg-mist text-brand-strong'}`}><Icon name={icon} size={26} /></span>
  <h3 class={`t-card mt-4 ${dark ? '!text-white' : ''}`}>{title}</h3>
  <p class={`mt-2 text-[.9375rem] ${dark ? 'text-slate-300' : ''}`}>{text}</p>
</div>
