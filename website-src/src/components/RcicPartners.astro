---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { rcicPartners } from '../data/rcicPartners';
interface Props { id?: string; tone?: 'dark' | 'light' }
const { id = 'rcic-members-partners', tone = 'dark' } = Astro.props;
const dark = tone === 'dark';
---
<section class={`section ${dark ? '' : 'section-soft'}`} id={id} aria-labelledby={`${id}-h`}>
  <div class="container-x">
    <div class={`relative overflow-hidden rounded-3xl p-8 sm:p-12 shadow-lift ${dark ? 'hero-bg on-dark' : 'bg-white border border-line'}`}>
      {dark && <div class="absolute inset-0 dots opacity-20" aria-hidden="true"></div>}
      <div class="relative grid lg:grid-cols-[auto_1fr_auto] gap-8 items-center">
        <span class={`flex h-16 w-16 items-center justify-center rounded-2xl ${dark ? 'bg-white/10 text-coral' : 'bg-navy text-coral'}`} aria-hidden="true"><Icon name="shield" size={32} /></span>
        <div class="max-w-3xl">
          <p class={`eyebrow mb-3 ${dark ? 'light' : ''}`}>Canadian immigration</p>
          <h2 id={`${id}-h`} class={`t-section ${dark ? '!text-white' : ''}`}>{rcicPartners.heading}</h2>
          <p class={`mt-4 text-lg ${dark ? 'text-white' : 'text-ink'}`}>{rcicPartners.statement}</p>
          <p class={`mt-3 text-sm ${dark ? 'text-slate-300' : ''}`}>{rcicPartners.note}</p>
        </div>
        <div class="flex flex-wrap gap-3"><Button href="/contact/" variant="primary">Ask Aman Maan</Button></div>
      </div>
    </div>
  </div>
</section>
